# Native octanol
! wb97x-d3 def2-TZVPD TightSCF EDA CPCM

%maxcore 4000

%pal
   nprocs 32
end

%cpcm
   smd true
   SMDSolvent "octanol"
end

%EDA
  FRAG1_METHODFILE "frag1method.txt"
  FRAG2_METHODFILE "frag2method.txt"
  FRAG1_C 1
  FRAG1_M 1
  FRAG2_C -1
  FRAG2_M 1
end

* xyzfile 0 1 R4N+PFOA-_wb.xyz

%frag
  Definition
    1 {0:54} end
    2 {55:79} end
  end
end
